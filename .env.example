# Only needed to test the contact form locally. Copy to .env.local and fill in from
# Firebase console > Project settings > Your apps > Web app. On Firebase Hosting the
# site finds this config by itself, so production needs nothing here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Or send the form to the local Firestore emulator instead (npx firebase-tools emulators:start):
# VITE_FIREBASE_PROJECT_ID=demo-evocati
# VITE_FIRESTORE_EMULATOR=127.0.0.1:8085
