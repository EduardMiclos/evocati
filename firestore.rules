rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // "Solicită o analiză" form → Trigger Email extension.
    // The browser may only ADD a message addressed to our own inbox, with the expected
    // fields and sizes, so the form can't be abused to send email anywhere else.
    // Nothing can be read, changed or deleted from the browser; requests are visible in
    // the Firebase console (Firestore → mail).
    match /mail/{id} {
      allow create: if isContactRequest(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function str(v, max) {
      return v is string && v.size() <= max;
    }

    function required(v, max) {
      return str(v, max) && v.size() > 0;
    }

    function isContactRequest(d) {
      return d.keys().hasAll(['to', 'message', 'form', 'createdAt'])
        && d.keys().hasOnly(['to', 'replyTo', 'message', 'form', 'createdAt'])
        // Must match CONTACT_FORM_TO in src/config.ts.
        && d.to == 'office@evocati-legal.ro'
        && d.createdAt == request.time
        && (!('replyTo' in d) || str(d.replyTo, 160))
        && d.message.keys().hasOnly(['subject', 'text'])
        && required(d.message.subject, 200)
        && required(d.message.text, 6000)
        && d.form.keys().hasOnly(['name', 'company', 'phone', 'email', 'amount', 'message'])
        && required(d.form.name, 120)
        && required(d.form.phone, 40)
        && str(d.form.get('company', ''), 160)
        && str(d.form.get('email', ''), 160)
        && str(d.form.get('amount', ''), 60)
        && str(d.form.get('message', ''), 4000);
    }
  }
}
